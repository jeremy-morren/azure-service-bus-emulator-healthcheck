<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <IsTestApplication>true</IsTestApplication>
        <EnableMSTestRunner>true</EnableMSTestRunner>

        <OutputType>exe</OutputType>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServiceBusEmulator.Healthcheck\ServiceBusEmulator.Healthcheck.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- See https://devblogs.microsoft.com/dotnet/testing-your-native-aot-dotnet-apps/#how-to-test-your-apps-in-native-aot-mode -->
        <PackageReference Include="MSTest.SourceGeneration" Version="4.4.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />

        <PackageReference Include="Microsoft.CodeCoverage.MSBuild" Version="18.11.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />

        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.0" />
        <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
        <PackageReference Include="MSTest.Analyzers" Version="4.4.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
